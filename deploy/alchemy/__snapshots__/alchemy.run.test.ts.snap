exports[`alchemy.run.ts stages > a preview runs hosted mode on stage-suffixed resources 1`] = `
{
  "output": {
    "url": "open-seo-pr-123",
  },
  "resources": [
    {
      "id": "open-seo-audit",
      "props": {
        "bundle": false,
        "compatibility": {
          "date": "2025-09-02",
          "flags": [
            "nodejs_compat",
            "global_fetch_strictly_public",
          ],
        },
        "env": {
          "AUDIT_SCRATCHPAD": {
            "resource": {
              "id": "AUDIT_SCRATCHPAD",
              "props": {
                "className": "AuditScratchpad",
              },
              "removal": "destroy",
              "type": "Cloudflare.DurableObject",
            },
          },
          "AUTH_MODE": "hosted",
          "AUTUMN_SECRET_KEY": {
            "config": {
              "redacted": "",
            },
          },
          "BROWSER": {
            "resource": {
              "id": undefined,
              "props": undefined,
              "removal": "destroy",
              "type": "Cloudflare.Browser",
            },
          },
          "CONTEXT_API_KEY": {
            "config": {
              "redacted": "",
            },
          },
          "CRAWLER_ACCESS_SECRET": {
            "config": {
              "redacted": "",
            },
          },
          "DATABASE_PROVIDER": "d1",
          "DATAFORSEO_API_KEY": {
            "config": {
              "redacted": "dataforseo-key",
            },
          },
          "DB": {
            "resource": {
              "id": "DB",
              "props": {
                "migrationsDir": "drizzle/sqlite",
                "migrationsTable": "d1_migrations",
                "name": "open-seo-db-pr-123",
              },
              "removal": "destroy",
              "type": "Cloudflare.D1.Database",
            },
          },
          "KV": {
            "resource": {
              "id": "KV",
              "props": {
                "title": "open-seo-kv-pr-123",
              },
              "removal": "destroy",
              "type": "Cloudflare.KV.Namespace",
            },
          },
          "POSTHOG_HOST": {
            "config": "",
          },
          "POSTHOG_PUBLIC_KEY": {
            "config": "",
          },
          "R2": {
            "resource": {
              "id": "R2",
              "props": {
                "lifecycleRules": [
                  {
                    "deleteObjectsTransition": {
                      "condition": {
                        "maxAge": 604800,
                        "type": "Age",
                      },
                    },
                    "id": "dataforseo-cache-expiry",
                    "prefix": "dataforseo-cache/",
                  },
                ],
                "name": "open-seo-r2-pr-123",
              },
              "removal": "destroy",
              "type": "Cloudflare.R2.Bucket",
            },
          },
          "SITE_AUDIT_WORKFLOW": {
            "resource": {
              "id": "site-audit-workflow-pr-123",
              "props": {
                "className": "SiteAuditWorkflow",
              },
              "removal": "destroy",
              "type": "Cloudflare.Workflow",
            },
          },
        },
        "limits": {
          "cpuMs": 300000,
        },
        "main": "./dist/open_seo_audit/index.js",
        "name": "open-seo-pr-123-audit",
        "observability": {
          "enabled": true,
          "traces": {
            "enabled": true,
          },
        },
        "url": false,
      },
      "removal": "destroy",
      "type": "Cloudflare.Worker",
    },
    {
      "id": "open-seo",
      "props": {
        "assets": {
          "directory": "./dist/client",
        },
        "bundle": false,
        "compatibility": {
          "date": "2025-09-02",
          "flags": [
            "nodejs_compat",
            "global_fetch_strictly_public",
          ],
        },
        "crons": [
          "*/5 * * * *",
          "17 3 * * *",
        ],
        "domain": undefined,
        "env": {
          "AI_VISIBILITY_WORKFLOW": {
            "resource": {
              "id": "ai-visibility-workflow-pr-123",
              "props": {
                "className": "AiVisibilityWorkflow",
                "scriptName": undefined,
