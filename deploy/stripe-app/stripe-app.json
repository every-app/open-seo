{
  "$schema": "https://stripe.com/stripe-app.schema.json",
  "id": "so.openseo.provider",
  "name": "OpenSEO",
  "version": "0.1.0",
  "provisioning": {
    "base_url": "https://app.openseo.so/api/stripe-projects/",
    "oauth_scopes": ["mcp"],
    "oauth_token_endpoint": "https://app.openseo.so/api/stripe-projects/oauth/token",
    "oauth_client_id": "openseo-stripe-projects",
    "oauth_client_secret_secret_store_key": "oauth_client_secret",
    "capabilities": [],
    "deep_link_purposes": ["dashboard"],
    "llm_context": "https://openseo.so/stripe-projects/llm-context.md"
  },
  "permissions": [
    {
      "permission": "secret_write",
      "purpose": "Store the OAuth client secret Stripe presents at OpenSEO's token endpoint."
    },
    {
      "permission": "provisioning_account_request_write",
      "purpose": "Create and sign in to OpenSEO accounts for Stripe Projects."
    }
  ],
  "distribution_type": "public",
  "stripe_api_access_type": "oauth",
  "sandbox_install_compatible": true
}
