# The first-party OpenSEO behind the hosted Every App gateway: Alchemy stage
# `everyapp`. Copy to .env.everyapp at the repo root (gitignored) and deploy with
# `pnpm deploy:everyapp:first-party`. Runbook: docs/EVERY_APP_DEPLOYMENT.md.
#
# No DataForSEO, Context, OpenRouter, Autumn or Google settings here: the
# gateway holds the provider keys, billing is off, and Google waits for the
# gateway. The stage never passes them to the Workers even if set.

# Read by both the build (the Every App client) and the stage.
AUTH_MODE=everyapp

# -----------------------------------------------------------------------------
# Gateway identity
# -----------------------------------------------------------------------------
# The hosted gateway's identity public key, as a JSON array of PEM strings on
# one line (single-quoted, line breaks as \n) or a single PEM. It is the
# gateway's install row: `SELECT jwt_public_key FROM _everyapp_install WHERE
# id = 'install'` in the gateway's D1 (every-app-gateway), the key app deploys
# hand to apps. Redeploy this stage after a gateway key rotation.
EVERYAPP_IDENTITY_PUBLIC_KEYS='["-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----\n"]'

# The hosted gateway. The identity issuer and OpenSEO's URL
# (https://openseo.<gateway host>) follow from it.
# EVERYAPP_GATEWAY_URL=https://app.everyapp.com
# EVERYAPP_IDENTITY_ISSUER=https://app.everyapp.com

# -----------------------------------------------------------------------------
# Postgres (PlanetScale) through Hyperdrive
# -----------------------------------------------------------------------------
# The origin of the stage's Hyperdrive config, open-seo-everyapp. Its own
# database: never app.openseo.so's.
HYPERDRIVE_ORIGIN_HOST=
# HYPERDRIVE_ORIGIN_PORT=5432
HYPERDRIVE_ORIGIN_DATABASE=
HYPERDRIVE_ORIGIN_USER=
HYPERDRIVE_ORIGIN_PASSWORD=

# -----------------------------------------------------------------------------
# The gateway binding (pnpm everyapp:bind-gateway, run after every deploy)
# -----------------------------------------------------------------------------
# Alchemy can't set the props of the EVERY_APP_GATEWAY service binding, so a
# script patches it onto both Workers through the Cloudflare API.
CLOUDFLARE_ACCOUNT_ID=
# An API token with Workers Scripts: Edit on that account. Not named
# CLOUDFLARE_API_TOKEN, which Alchemy would take as its own credentials.
EVERYAPP_BINDING_API_TOKEN=
# The platform organization (the hosted gateway's install organization,
# "Every App"), which owns OpenSEO as a shared app:
# `SELECT id FROM organizations ORDER BY created_at LIMIT 1` in the gateway's D1.
EVERYAPP_PLATFORM_ORG_ID=

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Encrypts the access signatures audits use to crawl protected sites.
# CRAWLER_ACCESS_SECRET=
# OPENROUTER_MODEL=
# Scheduled rank checks and AI visibility, once the gateway attributes
# background calls to organizations (x-everyapp-org).
# FIRST_PARTY_SCHEDULED_CHECKS=on
