# Copy to .env. Choose unique storage credentials before the first start.
STORAGE_ACCESS_KEY=openseo
STORAGE_SECRET_KEY=replace-with-a-long-random-secret
# password: email and password accounts. The first visitor creates the
# admin account; invitations add the rest.
# local_noauth: no sign-in and one admin user, as the old Docker image ran;
# only for private networks.
AUTH_MODE=password
# The public URL of this installation, in either mode.
BETTER_AUTH_URL=http://localhost:3001
PORT=3001
# Optional feature credentials; these are set at initialization, never compiled.
DATAFORSEO_API_KEY=
OPENROUTER_API_KEY=
# Leave empty for OpenRouter, or set another provider's base URL
# (e.g. https://api.example.com/v1). Set OPENROUTER_MODEL to a model it serves.
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CONTEXT_API_KEY=
