{
  "name": "seoshark-landing",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/generate-sitemap.js",
    "build:app": "vite build",
    "sitemap": "node scripts/generate-sitemap.js",
    "start": "wrangler dev",
    "preview": "vite preview",
    "types:check": "fumadocs-mdx && tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "deploy": "VITE_REQUIRE_TURNSTILE=1 npm run build && wrangler deploy",
    "deploy:prod": "VITE_REQUIRE_TURNSTILE=1 npm run build && wrangler deploy",
    "deploy:preview": "CLOUDFLARE_ENV=preview VITE_REQUIRE_TURNSTILE=1 npm run build && wrangler deploy",
    "test:protection": "vitest run && node scripts/check-free-tool-budget.cjs"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-start": "^1.168.26",
    "fumadocs-core": "^16.15.8",
    "fumadocs-mdx": "^13.0.8",
    "fumadocs-ui": "^16.15.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^7.3.6",
    "zod": "^4.6.1",
    "@radix-ui/react-popover": "^1.1.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.3",
    "@cloudflare/workers-types": "4.20260702.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "prettier": "^3.6.2",
    "srvx": "^0.11.22",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "3.2.6",
    "wrangler": "^4.67.0"
  }
}
