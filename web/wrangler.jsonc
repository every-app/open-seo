{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-seo-landing",
  "compatibility_date": "2026-02-19",
  // global_fetch_strictly_public: the SEO report reads pages of sites it is
  // asked about. With the flag, a request to a site on this Cloudflare account
  // goes through Cloudflare's front door like any other, not to the origin.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "./src/worker.ts",
  "vars": {
    "FREE_TOOLS_DAILY_BUDGET_USD": "100",
    // The SEO report tool (docs/maintainers/free-seo-report.md).
    // Other sites whose own forms may submit to it, comma-separated origins.
    "SEO_REPORT_PARTNER_ORIGINS": "https://sfseo.dev",
    // The OpenRouter model that writes a report, and its reasoning effort.
    // The model must be one priced in SEO_REPORT_MODEL_PRICES
    // (src/lib/free-tools/spend.ts): a report counts its spend from that.
    "SEO_REPORT_MODEL": "openai/gpt-6.2-sol",
    "SEO_REPORT_MODEL_EFFORT": "medium",
  },
  "durable_objects": {
    "bindings": [
      { "name": "FREE_TOOL_BUDGET", "class_name": "FreeToolBudget" },
      { "name": "SEO_REPORT_DESK", "class_name": "SeoReportDesk" },
    ],
  },
  "migrations": [
    { "tag": "free-tool-budget-v1", "new_sqlite_classes": ["FreeToolBudget"] },
    { "tag": "seo-report-desk-v1", "new_sqlite_classes": ["SeoReportDesk"] },
  ],
  "workflows": [
    {
      "name": "seo-report",
      "binding": "SEO_REPORT_WORKFLOW",
      "class_name": "SeoReportWorkflow",
    },
  ],
  "assets": {
    "directory": "./dist/client",
    "html_handling": "drop-trailing-slash",
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "routes": [
    {
      "pattern": "openseo.so",
      "custom_domain": true,
    },
    {
      "pattern": "www.openseo.so",
      "custom_domain": true,
    },
  ],
  "ratelimits": [
    {
      "name": "BACKLINK_CHECK_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "env": {
    // Bindings are not inherited by named envs; keep preview's copies in sync.
    "preview": {
      "name": "open-seo-landing-preview",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      // Preview has its own budget; it cannot consume the production allowance.
      "vars": {
        "FREE_TOOLS_DAILY_BUDGET_USD": "10",
        "SEO_REPORT_PARTNER_ORIGINS": "",
        "SEO_REPORT_MODEL": "openai/gpt-6.2-sol",
        "SEO_REPORT_MODEL_EFFORT": "medium",
      },
      "durable_objects": {
        "bindings": [
          { "name": "FREE_TOOL_BUDGET", "class_name": "FreeToolBudget" },
          { "name": "SEO_REPORT_DESK", "class_name": "SeoReportDesk" },
        ],
      },
      // A Workflow's name is the account's, so preview has its own.
      "workflows": [
        {
          "name": "seo-report-preview",
          "binding": "SEO_REPORT_WORKFLOW",
          "class_name": "SeoReportWorkflow",
        },
      ],
      "ratelimits": [
        {
          "name": "BACKLINK_CHECK_RATE_LIMIT",
          "namespace_id": "1001",
          "simple": { "limit": 5, "period": 60 },
        },
      ],
    },
  },
}
