# -----------------------------------------------------------------------------
# Core settings
# -----------------------------------------------------------------------------
# Required for SEO data features. See docs/DATAFORSEO_API_KEY.md.
# DATAFORSEO_API_KEY=

# Optional app port
# PORT=3001

# Optional reverse-proxy hosts for Docker self-hosting
# ALLOWED_HOST=yourdomain.com

# Optional image tag override for Docker self-hosting
# OPEN_SEO_IMAGE=ghcr.io/every-app/open-seo:latest

# -----------------------------------------------------------------------------
# Auth mode
# -----------------------------------------------------------------------------
# - cloudflare_access: validate Cloudflare Access JWTs (recommended for deploys)
# - local_noauth: local trusted mode with injected admin user (admin@localhost)
# - hosted: Better Auth email/password + organization mode
#
# Defaults to cloudflare_access when unset.
# AUTH_MODE=cloudflare_access

# Required when AUTH_MODE=cloudflare_access. See docs/SELF_HOSTING_CLOUDFLARE.md.
# TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# POLICY_AUD=your-cloudflare-access-aud-tag

# Required when AUTH_MODE=hosted
# BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# BETTER_AUTH_URL=http://localhost:3001
# GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
# POSTHOG_PUBLIC_KEY=replace-with-your-posthog-project-api-key
# POSTHOG_HOST=https://us.i.posthog.com
# LOOPS_API_KEY=replace-with-your-loops-api-key
# LOOPS_TRANSACTIONAL_VERIFY_EMAIL_ID=replace-with-your-loops-verify-template-id
# LOOPS_TRANSACTIONAL_RESET_PASSWORD_ID=replace-with-your-loops-reset-template-id

# Optional in self-hosted modes. Required if you want AI features like SAM,
# the in-app SEO agent. Create a key at https://openrouter.ai/settings/keys.
# OPENROUTER_API_KEY=replace-with-your-openrouter-api-key

# Optional in self-hosted modes. Required for the PageSpeed page and the
# get_pagespeed_insights MCP tool. Free, and no billing account needed — enable
# the PageSpeed Insights API and create an API key in Google Cloud. A key is
# mandatory: Google's anonymous quota is zero. See specs/0011.
# PAGESPEED_API_KEY=replace-with-your-google-api-key

# Optional in self-hosted modes. Required for the Traffic page and the
# get_vercel_traffic MCP tool. A Vercel access token with read access to the
# projects whose Web Analytics you want to read. See specs/0010.
# VERCEL_TOKEN=replace-with-your-vercel-access-token

# Optional in self-hosted modes. Required for the Stripe panel on the Revenue
# page and the get_stripe_revenue MCP tool. Use a restricted key with read
# access to Products, Subscriptions, Checkout Sessions, and Refunds (refund
# and net-revenue tiles degrade gracefully without the Refunds grant).
# See specs/0014.
# An organization-level key works too: enter each project's target account
# id ("acct_…") in that project's Stripe connection card.
# STRIPE_SECRET_KEY=replace-with-your-stripe-restricted-key

# Optional in self-hosted modes. Required for the RapidAPI panel on the
# Revenue page and the get_rapidapi_subscriptions MCP tool. RAPIDAPI_KEY is
# your key with access to the GraphQL Platform API; RAPIDAPI_GRAPHQL_URL is
# your hub's GraphQL endpoint (https://graphql-<hub>.p.rapidapi.com/ — it is
# per-hub, not a global constant). See specs/0014.
# RAPIDAPI_KEY=replace-with-your-rapidapi-key
# RAPIDAPI_GRAPHQL_URL=https://graphql-yourhub.p.rapidapi.com/

# Optional in self-hosted modes. Required if you want Google Search Console
# integration and MCP tools. BETTER_AUTH_SECRET is also required for GSC (it
# encrypts the stored OAuth tokens). See docs/SELF_HOSTING_GOOGLE_SEARCH_CONSOLE.md.
# GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
# BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
