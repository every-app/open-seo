# -----------------------------------------------------------------------------
# Core settings
# -----------------------------------------------------------------------------
# Required for SEO data features. See docs/DATAFORSEO_API_KEY.md.
# DATAFORSEO_API_KEY=

# Optional app port
# PORT=3001

# Optional reverse-proxy hosts for Docker self-hosting
# ALLOWED_HOST=yourdomain.com

# Optional image tag override for Docker self-hosting
# OPEN_SEO_IMAGE=ghcr.io/every-app/open-seo:latest

# -----------------------------------------------------------------------------
# Auth mode
# -----------------------------------------------------------------------------
# - cloudflare_access: validate Cloudflare Access JWTs (recommended for deploys)
# - local_noauth: local trusted mode with injected admin user (admin@localhost)
# - hosted: Better Auth email/password + organization mode
#
# Defaults to cloudflare_access when unset.
# AUTH_MODE=cloudflare_access

# Required when AUTH_MODE=cloudflare_access. See docs/SELF_HOSTING_CLOUDFLARE.md.
# TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# POLICY_AUD=your-cloudflare-access-aud-tag

# Required when AUTH_MODE=hosted
# BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# BETTER_AUTH_URL=http://localhost:3001
# GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
# POSTHOG_PUBLIC_KEY=replace-with-your-posthog-project-api-key
# POSTHOG_HOST=https://us.i.posthog.com
# LOOPS_API_KEY=replace-with-your-loops-api-key
# LOOPS_TRANSACTIONAL_VERIFY_EMAIL_ID=replace-with-your-loops-verify-template-id
# LOOPS_TRANSACTIONAL_RESET_PASSWORD_ID=replace-with-your-loops-reset-template-id

# Optional in self-hosted modes. Required if you want AI features like SAM,
# the in-app SEO agent. Four providers are supported; set at least one key:
#   OPENROUTER_API_KEY   https://openrouter.ai/settings/keys
#   OPENAI_API_KEY       https://platform.openai.com/api-keys
#   GEMINI_API_KEY       https://aistudio.google.com/apikey
#   ANTHROPIC_API_KEY    https://console.anthropic.com/settings/keys
#   OLLAMA_API_KEY       https://ollama.com (Ollama Cloud)
#
# OpenAI Compatible: any endpoint speaking the OpenAI chat API (gateways,
# vLLM, LM Studio, local Ollama at http://localhost:11434/v1). Base URL and
# key are deployment configuration; hosted builds only allow public HTTPS.
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_MODEL=
# Ollama Cloud — no local Ollama required. Default base URL:
#   https://ollama.com/v1
# OLLAMA_CLOUD_BASE_URL=
# Encryption key for UI-entered AI credentials (AES-GCM at rest). Falls back
# to BETTER_AUTH_SECRET when unset; required in local-noauth runs without it.
# AI_CREDENTIALS_ENCRYPTION_KEY=
# The provider used when no per-project/org settings row exists is chosen by
# AI_AGENT_PROVIDER (one of openrouter|openai|gemini|anthropic); it defaults to
# openrouter, which preserves the pre-O2 single-provider behavior.
# AI_AGENT_PROVIDER=openrouter
# Optional per-provider model overrides. AI_AGENT_MODEL applies to the
# AI_AGENT_PROVIDER; otherwise each provider falls back to its own env var,
# then to a built-in default (see src/server/features/ai/).
# AI_AGENT_MODEL=            # model slug for the AI_AGENT_PROVIDER
# OPENROUTER_MODEL=          # OpenRouter fallback model
# OPENAI_MODEL=              # OpenAI fallback model
# GEMINI_MODEL=              # Google Gemini fallback model
# ANTHROPIC_MODEL=           # Anthropic fallback model
# OLLAMA_CLOUD_MODEL=        # Ollama Cloud fallback model
# OPENAI_COMPATIBLE_MODEL=   # OpenAI-Compatible fallback model
# AI_AGENT_MAX_TOOL_CALLS=   # max tool calls per agent turn
# AI_AGENT_MAX_STEPS=        # max inference steps per agent turn
# Long-running tool polling (site audits): exponential backoff between status
# reads, attempt cap, and overall wall-clock window per wait.
# AI_AGENT_POLL_INITIAL_MS=  # first backoff delay (default 1000)
# AI_AGENT_POLL_MAX_MS=      # backoff cap (default 8000)
# AI_AGENT_MAX_POLL_ATTEMPTS= # max status reads per wait (default 12)
# AI_AGENT_TOOL_TIMEOUT_MS=  # overall window per wait (default 150000)

# Optional in self-hosted modes. Required if you want Google Search Console
# integration and MCP tools. BETTER_AUTH_SECRET is also required for GSC (it
# encrypts the stored OAuth tokens). See docs/SELF_HOSTING_GOOGLE_SEARCH_CONSOLE.md.
# GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
# BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# -----------------------------------------------------------------------------
# Free-first SEO data architecture
# -----------------------------------------------------------------------------
# The SEO data router checks cache → free providers → DataForSEO fallback.
# Set SEO_PROVIDER_ROUTER_ENABLED=false to disable the router and use the
# pre-router behavior (DataForSEO only, no cache-first).
# SEO_PROVIDER_ROUTER_ENABLED=true

# Disable DataForSEO entirely to run on free providers only.
# The app remains usable for functionality that has a free/internal provider.
# DATAFORSEO_ENABLED=true

# Optional budget guards for DataForSEO (USD). When exceeded, DataForSEO
# calls are blocked and a structured budget-exceeded result is returned.
# DATAFORSEO_DAILY_BUDGET=
# DATAFORSEO_MONTHLY_BUDGET=

# --- Google Search Console provider (free first-party data) ---
# Requires GOOGLE_CLIENT_ID/SECRET (shared with auth above) plus a connected
# GSC property per project via the dashboard.
# GOOGLE_SEARCH_CONSOLE_ENABLED=false

# --- Google Ads Keyword Planner provider (free keyword research) ---
# Uses the official Google Ads API for keyword ideas and historical metrics.
# GOOGLE_ADS_ENABLED=false
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=

# --- Bing Webmaster provider (free first-party search performance) ---
# BING_WEBMASTER_ENABLED=false
# BING_WEBMASTER_API_KEY=

# --- Local technical SEO crawler (free, no DataForSEO) ---
# Performs basic technical SEO checks (title, meta, canonical, headings,
# images, links, robots.txt, sitemap.xml, JSON-LD, hreflang) without
# DataForSEO. Respects robots.txt, concurrency limits, timeouts, and
# max crawl depth/URLs. Includes SSRF protection.
# LOCAL_CRAWLER_ENABLED=true

# --- Cache TTL overrides (seconds) ---
# The router caches every result with a per-data-type TTL. Override defaults:
# SEO_CACHE_TTL_KEYWORD_IDEAS=604800        (7 days)
# SEO_CACHE_TTL_KEYWORD_METRICS=604800     (7 days)
# SEO_CACHE_TTL_SERP=432000                (5 days)
# SEO_CACHE_TTL_DOMAIN_KEYWORDS=604800     (7 days)
# SEO_CACHE_TTL_COMPETITORS=604800         (7 days)
# SEO_CACHE_TTL_BACKLINKS=1209600          (14 days)
# SEO_CACHE_TTL_SITE_AUDIT=604800          (7 days)
# SEO_CACHE_TTL_SEARCH_CONSOLE=86400       (24 hours)
# SEO_CACHE_TTL_BING_SEARCH_PERFORMANCE=86400  (24 hours)
