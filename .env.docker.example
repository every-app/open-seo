# -----------------------------------------------------------------------------
# Docker Desktop local development (compose.dev.yaml)
# -----------------------------------------------------------------------------
# Copy to .env.docker and adjust. .env.docker is git-ignored; never commit it.
#
#   cp .env.docker.example .env.docker
#   docker compose -f compose.dev.yaml up --build
#
# All values here are OPTIONAL — the defaults in compose.dev.yaml are enough
# to start the app with every external SEO provider disabled.

# Optional app port (host and container). Default: 3001
# PORT=3001

# Auth mode for local dev. local_noauth runs a single admin user
# (admin@localhost) with no login screen. Do not expose publicly.
# AUTH_MODE=local_noauth

# -----------------------------------------------------------------------------
# Free-first SEO data architecture — provider flags
# -----------------------------------------------------------------------------
# All default to DISABLED for local development so no external API credits are
# consumed and no real credentials are required. The DataRouter then serves
# requests from the R2 cache and internal D1 data only.

# Paid DataForSEO fallback. Keep disabled for local dev to guarantee zero
# credit usage. Set true only with a real DATAFORSEO_API_KEY (base64 of
# login:password) to test the paid fallback path manually.
# DATAFORSEO_ENABLED=false
# DATAFORSEO_API_KEY=

# Optional DataForSEO budget guards (USD) — blocked with a structured
# budget-exceeded result when exceeded.
# DATAFORSEO_DAILY_BUDGET=1
# DATAFORSEO_MONTHLY_BUDGET=5

# Free first-party Google Search Console data. Requires a Google OAuth client
# (GOOGLE_CLIENT_ID/SECRET) AND a connected GSC property per project.
# GOOGLE_SEARCH_CONSOLE_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Free Google Ads Keyword Planner data.
# GOOGLE_ADS_ENABLED=false
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=

# Free Bing Webmaster search performance.
# BING_WEBMASTER_ENABLED=false
# BING_WEBMASTER_API_KEY=

# Local technical SEO crawler (free, no external API). On by default.
# LOCAL_CRAWLER_ENABLED=true

# -----------------------------------------------------------------------------
# Optional AI features (SAM agent, onboarding chat)
# -----------------------------------------------------------------------------
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# AI_AGENT_MODEL=
# AI_AGENT_MAX_TOOL_CALLS=
# AI_AGENT_MAX_STEPS=

# -----------------------------------------------------------------------------
# Filesystem watching
# -----------------------------------------------------------------------------
# Polling is enabled by default for reliable hot reload on Docker Desktop
# (Windows/macOS bind mounts don't propagate native filesystem events).
# Set to false on Linux for lower CPU if inotify works for your setup.
# CHOKIDAR_USEPOLLING=true
# WATCHPACK_POLLING=true

# -----------------------------------------------------------------------------
# Cache TTL overrides (seconds) — rarely needed for local dev
# -----------------------------------------------------------------------------
# SEO_CACHE_TTL_SERP=432000
