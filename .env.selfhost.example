# OpenSEO Cloudflare self-host. Walkthrough: docs/SELF_HOSTING_CLOUDFLARE_ALCHEMY.md

# ---------- Required ----------

# Get one at https://dataforseo.com â€” see docs/DATAFORSEO_API_KEY.md
DATAFORSEO_API_KEY=

# Who may sign in through Cloudflare Access, comma-separated
ACCESS_ALLOWED_EMAILS=

# ---------- Optional â€” uncomment to use ----------

# Google Search Console (all three together) â€” docs/SELF_HOSTING_GOOGLE_SEARCH_CONSOLE.md
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# BETTER_AUTH_SECRET=

# SAM, the in-app agent (hidden if unset). Four providers supported; set at
# least one key. AI_AGENT_PROVIDER picks the default provider when no
# settings row exists (default openrouter).
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_AGENT_PROVIDER=
# AI_AGENT_MODEL=
# OPENROUTER_MODEL=
# OPENAI_MODEL=
# GEMINI_MODEL=
# ANTHROPIC_MODEL=
# AI_AGENT_MAX_TOOL_CALLS=
# AI_AGENT_MAX_STEPS=

# Your own PostHog product analytics
# POSTHOG_PUBLIC_KEY=
# POSTHOG_HOST=

# Opt out of anonymized telemetry â€” docs/SELF_HOSTING_CLOUDFLARE_OPERATIONS.md
# OPENSEO_TELEMETRY_DISABLED=1

# Bring your own Cloudflare Access application instead of the auto-provisioned
# one (ACCESS_ALLOWED_EMAILS is then ignored)
# TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# POLICY_AUD=your-access-application-audience-tag
