# Localhost-only LedgerPe OpenSEO deployment
OPEN_SEO_IMAGE=ghcr.io/every-app/open-seo:latest
PORT=3001
ALLOWED_HOST=127.0.0.1
AUTH_MODE=local_noauth

# Privacy / telemetry
OPENSEO_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1

# Paid providers: disabled by default and budget-clamped to zero
OPENSEO_ENABLE_DATAFORSEO=0
OPENSEO_DATAFORSEO_BUDGET_USD=0
DATAFORSEO_API_KEY=

# Optional integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=

# Notes:
# - Leave DATAFORSEO_API_KEY blank unless explicitly enabling paid usage.
# - Even with an API key present, paid use should stay blocked unless
#   OPENSEO_ENABLE_DATAFORSEO=1 and OPENSEO_DATAFORSEO_BUDGET_USD > 0.
# - Keep this file out of git if real secrets are added.
