# Alchemy PROD deploy (stage "hosted-prod") to YOUR Cloudflare account, with
# Postgres on Supabase. Walkthrough: docs/SETUP.md. Adoption semantics and the
# first-cutover checklist are in docs/PREVIEW_DEPLOYMENTS.md.
# Cloudflare credentials come from `pnpm alchemy login`, not this file.
#
#   cp .env.production.example .env.production
#   pnpm deploy:postgres

AUTH_MODE=hosted
# Public origin of the app. Its hostname becomes the Worker's custom domain
# unless APP_DOMAINS overrides it.
BETTER_AUTH_URL=https://app.your-domain.com
# Optional: every custom domain the Worker should answer on, comma-separated.
# APP_DOMAINS=app.your-domain.com,www.app.your-domain.com
# BETTER_AUTH_SECRET=
# DATAFORSEO_API_KEY=

# ---------- Database: Supabase Postgres ----------
DATABASE_PROVIDER=postgres
# Option A (recommended on Cloudflare): Hyperdrive in front of Supabase.
# Alchemy creates the Hyperdrive config from these origin settings. Use the
# Supabase "Session pooler" host/port (IPv4-compatible, supports Hyperdrive).
# HYPERDRIVE_ORIGIN_HOST=aws-0-<region>.pooler.supabase.com
# HYPERDRIVE_ORIGIN_PORT=5432
# HYPERDRIVE_ORIGIN_DATABASE=postgres
# HYPERDRIVE_ORIGIN_USER=postgres.<project-ref>
# HYPERDRIVE_ORIGIN_PASSWORD=
#
# Option B: no Hyperdrive — connect straight to the Supabase transaction
# pooler (port 6543). Only read when no HYPERDRIVE binding exists.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Migrations run from your machine/CI, never from the Worker:
# POSTGRES_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ---------- Hosted auth ----------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Transactional email (verify, reset password, invitations) via Loops.
# LOOPS_API_KEY=
# LOOPS_TRANSACTIONAL_VERIFY_EMAIL_ID=
# LOOPS_TRANSACTIONAL_RESET_PASSWORD_ID=
# LOOPS_TRANSACTIONAL_INVITATION_ID=
# Signup captcha (Cloudflare Turnstile).
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=

# ---------- Billing, analytics, agents (all optional) ----------
# Credit metering + subscriptions via Autumn. Without it every org runs on the
# free plan defaults.
# AUTUMN_SECRET_KEY=
# AUTUMN_WEBHOOK_SECRET=
# Dub referral conversion tracking.
# DUB_API_KEY=
# Long random secret shared only with scripts/erase-user-data.ts.
# GDPR_ERASURE_SECRET=
# Your own PostHog project for product analytics.
# POSTHOG_PUBLIC_KEY=
# POSTHOG_HOST=
# SAM, the in-app agent (hidden if unset).
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
